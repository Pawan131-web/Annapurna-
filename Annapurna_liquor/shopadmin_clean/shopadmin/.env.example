# Copy this file to .env and fill in real values before running the project.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Kathmandu

# Database (SQLite - zero config, stored at BASE_DIR/db.sqlite3 by default)
# Optionally override the path/filename of the sqlite database file:
# DB_NAME=/absolute/path/to/db.sqlite3

# Email (used for password reset). Defaults to printing emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@shopadmin.local

# Business rules
DEFAULT_LOW_STOCK_THRESHOLD=10
